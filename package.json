{
  "name": "stride",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @stride/desktop dev",
    "build": "pnpm --filter @stride/desktop build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "electron": "pnpm --filter @stride/desktop electron",
    "electron:dev": "pnpm --filter @stride/desktop electron:dev",
    "electron:build": "pnpm --filter @stride/desktop electron:build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "electron", "app-builder-bin"]
  }
}
