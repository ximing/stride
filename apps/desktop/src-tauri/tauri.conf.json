{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stride",
  "version": "0.1.0",
  "identifier": "app.stride.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stride",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["stride"]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEOTJGNkM5MDcyOEFDNkMKUldSc3JDZ0h5ZmFTN1QxWWFKMVdzUVBMNkdQTUVJejhtdEhCRlhvc2NuTnNEblQxS0I3aFQ3TEgK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/ximing/stride/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "publisher": "Ximing",
    "category": "public.app-category.productivity",
    "shortDescription": "Local-first rich-text notes",
    "longDescription": "Stride is a local-first notes app: a folder of rich-text notes, versioned with git, with search and an AI agent. No account, no server — your notes stay on your machine.",
    "copyright": "Copyright (c) 2026 Ximing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
